<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>InkSumos Market</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="/css/theme.css">
        <link rel="stylesheet" href="/css/dashboard.css">
        <link rel="icon" href="/favicon1.jpg" type="image/png" id="pageIcon">
    </head>
    <body>
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <div class="contenedor container-fluid gap-3">
                    <div class="contenedor-logo">
                        <button class="navbar-brand btn p-0" onclick="backToHome()">
                            <img src="/favicon1.jpg" alt="InkSumos Market" class="img-fluid" id="logoImage" style="max-width: 90px;">
                        </button> 
                        <div class="texto-logo">
                            <span class="titulo-app">InkSumos Market</span>
                            <span class="subtitulo-app">Insumos de calidad para su impresora y repuestos de confianza.</span>
                        </div>
                    </div>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menuNav">
                        <ul class="menu navbar-nav ms-auto">
                            <li class="nav-item">
                                <a href="/admin/ventas">Ventas</a>
                            </li>
                            <li class="nav-item">
                                <a href="/admin/productos/crear" >+ Nuevo</a>
                            </li>
                            <li class="nav-item">
                                <button id="themeBtn" class="tema-btn">
                                    <span id="themeText">Tema</span>
                                </button>
                            </li>
                            <li class="nav-item">
                                <a href="/auth/logout" >Salir</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <main class="container my-5">
            <div class="mb-4">
                <h1 class="text-center">Gestión de Inventario</h1>
            </div>
            <!-- INSUMOS --> 
            <section class="category-section mb-5">
                <h2 class="mb-4 text-info">Insumos</h2>
                <div id="contenedorInsumos">
                    <% const insumosActivos= productos.filter(
                        producto => producto.categoryId === 1 && Number(producto.isActive) === 1);%>
                    <% insumosActivos.forEach(producto => { %>
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">
                                <div class="row g-0 align-items-center">
                                    <!-- IMAGEN -->
                                    <div class="col-md-2 text-center p-2">
                                        <img src="<%= producto.productImage %>" class="img-fluid rounded" alt="<%= producto.productName %>">
                                    </div>
                                    <!-- INFO + ACCIONES -->
                                    <div class="col-md-10 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="mb-1">
                                                <%= producto.productName %>
                                            </h5>
                                            <small class="text-muted">
                                                $ <%= producto.price %>
                                            </small>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-warning btn-sm btn-editar" data-id="<%= producto.id %>" data-name="<%= producto.productName %>">
                                                Editar
                                            </button>
                                            <!--
                                                <a class="editar" href="/admin/productos/editar/<%= producto.id %>">
                                                    Editar
                                                </a>
                                            -->
                                            <button class="btn btn-danger btn-sm btn-eliminar" data-id="<%= producto.id %>" data-name="<%= producto.productName %>">
                                                Eliminar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </section>
            <!-- Repuestos -->
            <section class="category-section mb-5">
                <h2 class="mb-4 text-warning">Repuestos</h2>
                <div id="contenedorProductividad">
                    <% const repuestosActivos= productos.filter(
                        producto => producto.categoryId === 2 && Number(producto.isActive) === 1);%>
                    <% repuestosActivos.forEach(producto => {%>
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">
                                <div class="row g-0 align-items-center">
                                    <!-- IMAGEN -->
                                    <div class="col-md-2 text-center p-2">
                                        <img src="<%= producto.productImage %>" class="img-fluid rounded" alt="<%= producto.productName %>">
                                    </div>
                                    <!-- INFO + ACCIONES -->
                                    <div class="col-md-10 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="mb-1">
                                                <%= producto.productName %>
                                            </h5>
                                            <small >
                                                $ <%= producto.price %>
                                            </small>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-warning btn-sm btn-editar" data-id="<%= producto.id %>" data-name="<%= producto.productName %>">
                                                Editar
                                            </button>
                                            <!--
                                                <a class="editar" href="/admin/productos/editar/<%= producto.id %>">
                                                    Editar
                                                </a>
                                            -->
                                            <button class="btn btn-danger btn-sm btn-eliminar" data-id="<%= producto.id %>" data-name="<%= producto.productName %>">
                                                Eliminar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </section>
            <!-- Insumos o Repuestos inactivos -->
            <section class="categoria-section mb-5">
                <h2 class="mb-4 text-secondary">Productos dados de baja</h2>
                <div id="contenedorInactivos">
                    <% const inactivos = productos.filter(producto => Number(producto.isActive) !== 1); %>
                    <% if (inactivos.length === 0) { %>
                        <p>No hay productos dados de baja.</p>
                    <% } %>
                    <% inactivos.forEach(producto => { %>
                        <div class="card mb-3 shadow-sm border-secondary">
                            <div class="card-body">
                                <div class="row g-0 align-items-center">
                                    <div class="col-md-2 text-center p-2">
                                        <img src="<%= producto.productImage %>" class="img-fluid rounded" alt="<%= producto.productName %> Inactivo">
                                    </div>
                                    <div class="col-md-10 d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="mb-1">
                                                <%= producto.productName %>
                                            </h5>
                                            <small >
                                                $ <%= producto.price %>
                                            </small>
                                        </div>
                                        <button class="btn btn-success btn-sm btn-reactivar" data-id="<%= producto.id %>" data-name="<%= producto.productName %>">
                                            Reactivar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </section>
        </main>
        <footer>
			<small>
				TP -> Tilcara, Juan Alberto - De Marco, Matias
			</small>
		</footer>
        <script src="/js/dashboard.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>   
        <script src="/js/theme.js"></script>
    </body>
</html>