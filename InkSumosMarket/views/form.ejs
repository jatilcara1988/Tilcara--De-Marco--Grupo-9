<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= producto ? "Editar producto" : "Nuevo producto" %></title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="/css/theme.css">
        <link rel="stylesheet" href="/css/form.css">
        <link rel="icon" href="/favicon1.jpg" type="image/png" id="pageIcon">
    </head>
    <body >
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <div class="contenedor container-fluid gap-3">
                    <div class="contenedor-logo">
                        <button class="navbar-brand btn p-0" onclick="backToHome()">
                            <img src="/favicon1.jpg" alt="InkSumos Market" class="img-fluid" id="logoImage" style="max-width: 90px;">
                        </button>
                        <div class="texto-logo">
                            <span class="titulo-app">InkSumos Market</span>
                            <span class="subtitulo-app">Insumos de calidad para su impresora y repuestos de confianza.</span>
                        </div>
                    </div>
                    <!-- Botón hamburguesa -->
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <!-- Menú -->
                    <div class="collapse navbar-collapse" id="menuNav">
                        <ul class="menu navbar-nav ms-auto">
                            <li class="nav-item">
                                <a href="/admin/dashboard">Panel</a>
                            </li>
                            <% if(producto){ %>
                            <li class="nav-item">
                                <a href="/admin/productos/crear">+ Nuevo</a>
                            </li>
                            <% } %>
                            <li class="nav-item">
                                <a href="/admin/ventas">+ Ventas</a>
                            </li>
                            <li class="nav-item">
                                <button id="themeBtn" class="theme-btn">
                                    Tema
                                </button>
                            </li>
                            <li class="nav-item">
                                <a href="/auth/logout">Salir</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
        <main class="page-form">
            <div class="container mt-5">
                <h2 class="mb-4 text-center">
                    <%= producto ? "Editar producto" : "Crear producto" %>
                </h2>
                <form id="form" action="<%= producto ? '/admin/productos/editar/' + producto.id : '/admin/productos/crear' %>" method="POST" enctype="multipart/form-data">
                    <!-- NOMBRE -->
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" name="nombre" class="form-control" value="<%= producto ? producto.productName : '' %>" minlength="3" maxlength="100" required>
                    </div>
                    <!-- DESCRIPCION -->
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea name="descripcion" class="form-control" rows="4" minlength="10" maxlength="500" required><%= producto ? producto.productDescription : '' %></textarea>
                    </div>
                    <!-- PRECIO -->
                    <div class="mb-3">
                        <label class="form-label">Precio</label>
                        <input type="number" name="precio" class="form-control" value="<%= producto ? producto.price : '' %>" min="0" required>
                    </div>
                    <!-- STOCK -->
                    <div class="mb-3">
                        <label class="form-label">Stock</label>
                        <input type="number" name="stock" class="form-control" value="<%= producto ? producto.stock : '' %>" min="0" step="1" required>
                    </div>
                    <!-- IMAGEN -->
                    <div class="mb-3">
                        <label class="form-label">Imagen</label>
                        <input type="file" name="imagen" class="form-control" accept=".jpg,.jpeg,.png,.webp">
                        <% if (producto && producto.productImage) { %>
                            <input type="hidden" name="imagenActual" value="<%= producto.productImage %>">
                            <small class=" d-block mt-2">Si no eliges un archivo nuevo, se mantiene la imagen actual.</small>
                        <% } %>
                    </div>
                    <!-- CATEGORIA -->
                    <% if (!producto) { %>
                        <div class="mb-3">
                            <label class="form-label">Categoría</label>
                            <select name="categoria_id" class="form-select mb-3">
                                <option value="1">Insumos</option>
                                <option value="2">Repuestos</option>
                            </select>
                        </div>
                    <% } else { %>
                        <div>
                            <input type="hidden" name="categoria_id" value="<%= producto.categoryId %>">
                        </div>              
                    <% } %>
                    <div id="avisoError" class="alert alert-danger d-none"></div>
                    <% if (errores && errores.length) { %>
                        <% errores.forEach(error => { %>
                            <div class="alert alert-danger">
                                <%= error %>
                            </div>
                        <% }) %>
                    <% } %>
                    <div class="d-flex justify-content-end gap-2 mb-5">
                        <button type="submit" class="btn btn-success">
                            <%= producto ? "Actualizar" : "Crear" %>
                        </button>
                        <a href="/admin/dashboard" class="btn btn-secondary">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </main>
        <footer>
			<small>
				TP -> Tilcara, Juan Alberto - De Marco, Matias
			</small>
		</footer>
        <script src="/js/form.js"></script>
        <script src="/js/theme.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>  
    </body>
</html>